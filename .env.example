# JeevanSetu environment configuration
# MongoDB is the ONLY application database (local mongod, Docker Compose or Atlas).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=jeevansetu_db

# Optional: path for the embedded mongod used when MONGODB_URI is unreachable
# MONGODB_DBPATH=/tmp/jeevansetu-mongo

# Optional external routing service (the built-in graph engine is used otherwise)
# OSRM_BASE_URL=https://router.project-osrm.org

# Optional: enable Google Places building/address search (requires Places API (New) and billing)
# GOOGLE_MAPS_API_KEY=

# Road-following routing (OpenStreetMap). Public demo servers are used by default;
# for production point these at a self-hosted OSRM / Valhalla built on a Gujarat OSM extract.
# OSRM_BASE_URL=https://router.project-osrm.org
# VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
